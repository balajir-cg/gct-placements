# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=

# Collections
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_JOBS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_APPLICATIONS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_PLACEMENTS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_COMPANIES_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_ADMIN_ROLES_COLLECTION_ID=

# Email Validation
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=gct.ac.in

APPWRITE_API_KEY=

# AI Vision for Marksheet OCR
OPENROUTER_API_KEY=your-openrouter-api-key
# Vision models (choose one):
# Free option (may have availability issues): qwen/qwen2.5-vl-32b-instruct:free
# Paid options (more reliable):
# - google/gemini-flash-1.5-8b (fast and cheap)
# - anthropic/claude-3-haiku (better accuracy)
# - openai/gpt-4o-mini (balanced)
VISION_MODEL=qwen/qwen2.5-vl-32b-instruct:free
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=GCT Placement Portal


